# ===== Variáveis de ambiente (template) =====
# Copie este arquivo para `.env` e preencha com seus valores reais.
# O `.env` NUNCA deve ser commitado (está no .gitignore).

# Senha do admin do Grafana (primeiro login)
GF_SECURITY_ADMIN_PASSWORD=admin

# Telegram bot (Alertmanager)
# Token do bot criado no @BotFather
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
# Seu chat_id (descoberto via getUpdates)
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI