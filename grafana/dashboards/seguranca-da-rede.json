   {
    "id": 1,
    "datasource": {
     "type": "prometheus",
     "uid": "__PROMUID__"
    },
    "type": "stat",
    "title": "Conexões com a internet (agora)",
    "gridPos": {
     "h": 5,
     "w": 4,
     "x": 0,
     "y": 0
    },
    "fieldConfig": {
     "defaults": {
      "unit": "short",
      "mappings": [],
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "yellow",
         "value": 200
        },
        {
         "color": "red",
         "value": 600
        }
       ]
      }
     },
     "overrides": []
    },
    "options": {
     "colorMode": "background",
     "graphMode": "area",
     "reduceOptions": {
      "calcs": [
       "lastNotNull"
      ]
     },
     "textMode": "auto"
    },
    "targets": [
     {
      "expr": "windows_security_external_connections_all",
      "legendFormat": "conexões",
      "refId": "A"
     }
    ]
   },
